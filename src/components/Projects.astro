---
import Picture from './Picture.astro';
import Icon from './Icon.astro';
import { business } from '../data/business';
import { t, type Lang } from '../i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const items = [
  { img: 'proj-kitchen', key: 'kitchen', cls: 'wide' },
  { img: 'proj-clinic', key: 'clinic', cls: 'tall' },
  { img: 'proj-bedframe', key: 'bedFrame', cls: 'tall' },
  { img: 'proj-living', key: 'livingSofa', cls: 'tall' },
  { img: 'proj-bedroom', key: 'bedroom', cls: 'tall', viz: true },
] as const;
---

<section class="section section--sand projects" id="projects" aria-labelledby="projects-title">
  <div class="container">
    <div class="projects__head">
      <div class="section-head reveal">
        <p class="eyebrow">{d.projects.eyebrow}</p>
        <h2 id="projects-title">{d.projects.title}</h2>
        <p>{d.projects.lead}</p>
      </div>
      <a class="btn btn--ghost reveal" href={business.instagram.url} target="_blank" rel="noopener">
        <Icon name="instagram" />
        {d.projects.instagram}
        <span class="visually-hidden">{d.a11y.newTab}</span>
      </a>
    </div>
    <ul class="projects__grid">
      {
        items.map((it, i) => (
          <li class:list={['projects__item', `projects__item--${it.cls}`, 'reveal']} style={`--delay:${(i % 3) * 0.07}s`}>
            <figure>
              <div class="media projects__media">
                <Picture
                  name={it.img}
                  alt={d.projects.items[it.key]}
                  sizes={it.cls === 'wide' ? '(max-width: 760px) 92vw, 62vw' : '(max-width: 760px) 92vw, 31vw'}
                />
                {'viz' in it && <span class="badge badge--soft projects__badge">{d.furniture.visualization}</span>}
              </div>
              <figcaption>{d.projects.items[it.key]}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .projects__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1rem 2rem;
    margin-bottom: var(--space-6);
  }
  .projects__head .section-head {
    margin-bottom: 0;
  }
  .projects__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .projects__item figure {
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .projects__item--wide {
    grid-column: span 2;
  }
  .projects__item--wide .projects__media {
    aspect-ratio: 3 / 2;
  }
  .projects__item--tall .projects__media {
    aspect-ratio: 3 / 4;
  }
  .projects__badge {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
  }
  figcaption {
    font-size: 0.92rem;
    color: var(--ink-2);
  }
  @media (max-width: 760px) {
    .projects__grid {
      grid-template-columns: 1fr;
    }
    .projects__item--wide {
      grid-column: auto;
    }
    .projects__item--tall .projects__media {
      aspect-ratio: 4 / 4.6;
    }
  }
</style>
