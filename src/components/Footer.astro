---
import Logo from './Logo.astro';
import { business } from '../data/business';
import { t, langs, langLabels, type Lang } from '../i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const year = new Date().getFullYear();
const links = [
  { href: '#furniture', label: d.nav.furniture },
  { href: '#colors', label: d.nav.colors },
  { href: '#process', label: d.nav.process },
  { href: '#projects', label: d.nav.projects },
  { href: '#request', label: d.inquiry.eyebrow },
  { href: '#contact', label: d.nav.contact },
];
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <Logo tone="light" />
      <p>{d.footer.tagline}</p>
    </div>
    <nav aria-label={d.footer.nav}>
      <ul class="footer__links">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="footer__contact">
      <a href={`tel:${business.phone.e164}`}>{business.phone.displayIntl}</a>
      <a href={business.instagram.url} target="_blank" rel="noopener">
        Instagram · @{business.instagram.handle}
        <span class="visually-hidden">{d.a11y.newTab}</span>
      </a>
      <span>{business.locality[lang]}</span>
      <div class="footer__lang" role="group" aria-label={d.a11y.langGroup}>
        {
          langs.map((l) => (
            <a href={`/${l}/`} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} data-lang-switch={l}>
              {langLabels[l].long}
            </a>
          ))
        }
      </div>
    </div>
  </div>
  <div class="container footer__legal">
    <p>© {year} {business.name}. {d.footer.rights}</p>
    <p>{d.footer.imagery}</p>
  </div>
</footer>

<style>
  .footer {
    background: #0f0d0b;
    color: var(--on-night-2);
    padding-block: var(--space-7) var(--space-5);
    font-size: 0.92rem;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 2rem;
    padding-bottom: var(--space-5);
    border-bottom: 1px solid rgba(243, 236, 226, 0.12);
  }
  .footer__brand {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .footer__links {
    list-style: none;
    display: grid;
    gap: 0.25rem;
  }
  .footer a {
    text-decoration: none;
    color: var(--on-night);
    display: inline-flex;
    align-items: center;
    min-height: 32px;
  }
  .footer a:hover {
    color: var(--gold-light);
  }
  .footer__contact {
    display: grid;
    gap: 0.25rem;
    align-content: start;
  }
  .footer__lang {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .footer__lang a[aria-current='true'] {
    color: var(--gold-light);
    text-decoration: underline;
  }
  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: var(--space-4);
    font-size: 0.8rem;
  }
  @media (max-width: 760px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
